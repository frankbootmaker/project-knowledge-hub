# Example env for compose.dokploy.yaml (Dev/UAT). Copy to a Dokploy secret store — do not commit real values.
# Only set optional vars when you have real values (empty SMTP_* / MCP_PUBLIC_URL break Zod).

APP_ENV=staging
NODE_ENV=production
LOG_LEVEL=info

# Public HTTPS origin for THIS preview app (must differ from live KnowHub).
WEB_URL=https://knowledge-hub-new-design.example.com

# Optional. When unset, public MCP defaults to {WEB_URL}/mcp (same-origin rewrite).
# Only set if clients must use a different public host than WEB_URL.
# MCP_PUBLIC_URL=https://knowledge-hub-new-design.example.com/mcp

# Do NOT set API_URL=http://localhost:3101 here — that poisons the web image
# (Next would proxy to itself). This branch hardcodes http://nd-api:3101.

# Postgres (Compose service hostname `nd-postgres`). Compose builds DATABASE_URL from these —
# do not rely on a laptop DATABASE_URL pointing at 127.0.0.1.
POSTGRES_DB=knowledge_hub
POSTGRES_USER=knowledge_hub
POSTGRES_PASSWORD=change-me-strong-password

# Document/image import (MarkItDown sidecar on project network)
MARKITDOWN_URL=http://nd-markitdown:8080
# MARKITDOWN_TIMEOUT_MS=120000
# DOCUMENT_IMPORT_MAX_BYTES=26214400
# DOCUMENT_IMPORT_OCR_ENGINE=none
# Optional OpenAI-compatible vision OCR (injected into nd-markitdown too)
# VISION_LLM_BASE_URL=https://api.openai.com/v1
# VISION_LLM_API_KEY=
# VISION_LLM_MODEL=gpt-4o-mini
# Or Ollama: VISION_LLM_BASE_URL=http://<ollama-host>:11434/v1 VISION_LLM_API_KEY=ollama VISION_LLM_MODEL=llava
# Fallback OCR language when form omits ocrLang (eng | deu | hun; form defaults from UI locale)
# TESSERACT_LANG=eng

# Auth (min 32 characters)
SESSION_SECRET=change-me-to-a-long-random-string-min-32

# OIDC SSO (Authentik / generic). Set all three to enable the login button.
# Register redirect: {WEB_URL}/api/v1/auth/oidc/callback
# OIDC_ISSUER=https://authentik.example.com/application/o/knowhub/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_BUTTON_LABEL=Sign in with SSO
# OIDC_IDP_SOURCE=authentik

# Optional first-boot seed (Compose `seed` one-shot after migrate; no-op if unset or admin exists)
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-pass
# BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
DEFAULT_ORGANIZATION_NAME=Default Organization
DEFAULT_ORGANIZATION_SLUG=default

# Ops-0 DB backup sidecar (compose service db-backup → volume knowledge_hub_backups)
# API also mounts the same volume at BACKUP_DIR for Admin → Monitoring.
# BACKUP_DIR=/backups
# BACKUP_MAX_UPLOAD_BYTES=536870912
# BACKUP_ENABLED=true
# BACKUP_INTERVAL_SECONDS=86400
# Admin → Monitoring can override via /backups/schedule.json (no sidecar restart).
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=3
# BACKUP_AUTO_ROTATE=true
# BACKUP_STALE_AFTER_HOURS=36
# BACKUP_STALE_ALERT_INTERVAL_MS=900000
# ALERT_WEBHOOK_URL=
# ALERT_ERROR_SPIKE_THRESHOLD=50
# ALERT_ERROR_SPIKE_WINDOW_MINUTES=15
# ALERT_DISK_FREE_RATIO_MIN=0.1
# AUDIT_RETENTION_DAYS=90
# AUDIT_RETENTION_INTERVAL_MS=86400000
# BACKUP_OFFSITE=true
# BACKUP_OFFSITE_SYNC_INTERVAL_MS=300000
# BACKUP_RUN_ON_START=1
#
# BlobStore offsite (S3-compatible: AWS / R2 / B2 / MinIO / …)
# Prefer Admin → Storage in the UI after deploy; env remains the fallback.
# BLOB_PROVIDER=disabled
# BLOB_PROVIDER=s3
# BLOB_S3_BUCKET=knowledge-hub
# BLOB_S3_REGION=auto
# BLOB_S3_ENDPOINT=
# BLOB_S3_ACCESS_KEY_ID=
# BLOB_S3_SECRET_ACCESS_KEY=
# BLOB_S3_FORCE_PATH_STYLE=false
# Isolate objects from live KnowHub if both share one bucket.
BLOB_KEY_PREFIX=new-design/

# Local filesystem fallbacks when BLOB_PROVIDER=disabled (shared volume on api+worker).
# compose.dokploy.yaml mounts nd_knowledge_hub_data → /data and sets these by default.
# DATA_DIR=/data
# AVATAR_UPLOAD_DIR=/data/avatars
# MEDIA_UPLOAD_DIR=/data/media
# DOCUMENT_IMPORT_DIR=/data/imports
# STYLE_PACK_UPLOAD_DIR=/data/style-packs
# MEDIA_MAX_BYTES=5242880
# DOCUMENT_IMPORT_MAX_BYTES=26214400

# Signup pending escalation (4 | 12 | 24 hours; worker poll)
# SIGNUP_PENDING_ESCALATE_AFTER_HOURS=4
# SIGNUP_PENDING_ESCALATE_INTERVAL_MS=900000

# Embeddings (default: FTS only)
EMBEDDING_PROVIDER=disabled
SEARCH_HYBRID_ENABLED=false

# Mail (console | smtp | resend). For smtp/resend, set the matching vars in Dokploy only.
MAIL_DRIVER=console
# MAIL_FROM=Project Knowledge Hub <noreply@example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# RESEND_API_KEY=
# RESEND_BASE_URL=https://api.freeresend.com
