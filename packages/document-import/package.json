{
  "name": "@project-knowledge-hub/document-import",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Document/image import schemas and MarkItDown helpers",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
